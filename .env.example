# Database Configuration for BrainArena
# Copy this file to .env and adjust values if needed:
#   cp .env.example .env

DB_HOST=localhost
DB_PORT=3306
DB_NAME=quizbattle
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Optional: full JDBC URL override (if provided, DB_HOST/DB_PORT/DB_NAME will be ignored)
# DB_URL=jdbc:mysql://localhost:3306/quizbattle?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
